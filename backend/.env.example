# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firecrawl API
FIRECRAWL_API_KEY=fc-your-api-key

# OpenAI API (for AI sentiment analysis)
OPENAI_API_KEY=sk-your-api-key

# Bright Data API (for TikTok scraping — optional, graceful degradation)
BRIGHTDATA_API_KEY=

# Xiaohongshu MCP Server URL (optional, falls back to Firecrawl)
XHS_MCP_URL=http://localhost:18060/mcp

# Application Settings
APP_ENV=development
APP_DEBUG=false

# Scheduler Settings
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_HOURS=24
MAX_VARIETIES_PER_BATCH=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
